{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlexSuite",
  "version": "1.2.0",
  "identifier": "com.danavans.plexsuite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "PlexSuite",
        "center": true,
        "width": 1200,
        "height": 830
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}


